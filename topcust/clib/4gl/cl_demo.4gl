        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetTlfb510HTTPResp.getStatusCode()||" ("||GetTlfb510HTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY

  #
  # RESET VARIABLES
  #
  LET GetTlfb510HTTPReq = NULL
  LET GetTlfb510HTTPResp = NULL
  RETURN wsstatus
END FUNCTION




          LET wsstatus = 0

        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetItemGroupDataHTTPResp.getStatusCode()||" ("||GetItemGroupDataHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status

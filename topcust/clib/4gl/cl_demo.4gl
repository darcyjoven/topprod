    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Version IS NOT NULL THEN
      CALL CheckApsExecutionHTTPReq.setVersion(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Version)
    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie IS NOT NULL THEN
      CALL CheckApsExecutionHTTPReq.setHeader("Cookie",TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie)
    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout <> 0 THEN
      CALL CheckApsExecutionHTTPReq.setConnectionTimeout(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout)
    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ReadWriteTimeout <> 0 THEN
      CALL CheckApsExecutionHTTPReq.setTimeout(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ReadWriteTimeout)
    END IF
  CATCH
    LET wsstatus = STATUS
    CALL WSHelper_FillSOAP11WSError("Client","Cannot create HTTPRequest")
    LET CheckApsExecutionHTTPReq = NULL
    RETURN wsstatus
  END TRY

    #
    # Stax request
    #
    TRY
      LET writer = CheckApsExecutionHTTPReq.beginXmlRequest()
      CALL WSHelper_WriteStaxSOAP11StartEnvelope(writer)
      CALL WSHelper_WriteStaxSOAP11StartBody(writer)
      #
      # STAX SOAP REQUEST SERIALIZE
      #
      CALL xml.Serializer.VariableToStax(CheckApsExecutionRequest,writer)
      CALL WSHelper_WriteStaxSOAP11EndBody(writer)
      CALL WSHelper_WriteStaxSOAP11EndEnvelope(writer)
      CALL CheckApsExecutionHTTPReq.endXmlRequest(writer)
    CATCH
      LET wsstatus = STATUS
      CALL WSHelper_FillSOAP11WSError("Client",SQLCA.SQLERRM)
      LET CheckApsExecutionHTTPReq = NULL
      RETURN wsstatus
    END TRY

  #
  # PROCESS RESPONSE
  #
  TRY
    LET CheckApsExecutionHTTPResp = CheckApsExecutionHTTPReq.getAsyncResponse()
    RETURN 0 # SUCCESS
  CATCH
    LET wsstatus = STATUS
    CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    LET CheckApsExecutionHTTPReq = NULL
    RETURN wsstatus
  END TRY
END FUNCTION



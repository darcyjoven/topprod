          #
          # STAX SOAP FAULT
          #
          LET reader = GetWOIssueDataHTTPResp.beginXmlResponse() # Begin Streaming Response
          IF NOT WSHelper_ReadStaxSOAP11StartEnvelope(reader) THEN
            EXIT CASE

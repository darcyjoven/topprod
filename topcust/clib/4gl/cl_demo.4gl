  #
  TRY
    LET SCM_CreateERPWipCompletionHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL SCM_CreateERPWipCompletionHTTPReq.setMethod("POST")

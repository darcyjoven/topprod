    IF GetWOIssueDataHTTPResp IS NULL THEN
      # Still no response, try again
      LET GetWOIssueDataHTTPResp = GetWOIssueDataHTTPReq.getAsyncResponse()
    END IF

    IF GetWOIssueDataHTTPResp IS NULL THEN

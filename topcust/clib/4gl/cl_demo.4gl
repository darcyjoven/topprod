  #
  # CREATE REQUEST
  #
  TRY
    LET GetDeliverymeiHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL GetDeliverymeiHTTPReq.setMethod("POST")
    CALL GetDeliverymeiHTTPReq.setCharset("UTF-8")

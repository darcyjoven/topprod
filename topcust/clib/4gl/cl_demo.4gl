#
# Operation: CreateBillingAP
#

#
# FUNCTION: CreateBillingAP
#
FUNCTION CreateBillingAP(p_request)
  DEFINE	soapStatus		INTEGER
  DEFINE	p_request		STRING

  LET CreateBillingAPRequest.request = p_request

  LET soapStatus = CreateBillingAP_g()

  RETURN soapStatus, CreateBillingAPResponse.response
END FUNCTION

#

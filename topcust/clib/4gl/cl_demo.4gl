  TRY
    LET CheckMemberUpgradeHTTPResp = CheckMemberUpgradeHTTPReq.getAsyncResponse()
    RETURN 0 # SUCCESS
  CATCH
    LET wsstatus = STATUS
    CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    LET CheckMemberUpgradeHTTPReq = NULL
    RETURN wsstatus
  END TRY
END FUNCTION


FUNCTION CheckMemberUpgradeResponse_g()
  DEFINE wsstatus        INTEGER
  DEFINE nb              INTEGER
  DEFINE uri             STRING
  DEFINE setcookie       STRING
  DEFINE mustUnderstand  INTEGER
  DEFINE reader          xml.StaxReader

  LET wsstatus = -1

  LET uri = com.WebServiceEngine.GetOption("SoapModuleURI")
  #
  # CHECK PREVIOUS CALL  
  #
  IF CheckMemberUpgradeHTTPReq IS NULL THEN
    # No request was sent
    CALL WSHelper_FillSOAP11WSError("Client","No request has been sent")
    RETURN -1
  END IF

  TRY
    #
    # PROCESS RESPONSE
    #
    IF CheckMemberUpgradeHTTPResp IS NULL THEN
      # Still no response, try again
      LET CheckMemberUpgradeHTTPResp = CheckMemberUpgradeHTTPReq.getAsyncResponse()
    END IF

    IF CheckMemberUpgradeHTTPResp IS NULL THEN
      # We got no response, still waiting for
      CALL WSHelper_FillSOAP11WSError("Client","Response was not yet received")
      RETURN -2
    END IF

      #
      # RETRIEVE SERVICE SESSION COOKIE

# Operation: GetCheck
#

#
# FUNCTION: GetCheck
#
FUNCTION GetCheck(p_request)
  DEFINE	soapStatus		INTEGER
  DEFINE	p_request		STRING

  LET GetCheckRequest.request = p_request

  LET soapStatus = GetCheck_g()

  RETURN soapStatus, GetCheckResponse.response
END FUNCTION


    #
    IF cws_get_finish_worksHTTPResp IS NULL THEN
      # Still no response, try again
      LET cws_get_finish_worksHTTPResp = cws_get_finish_worksHTTPReq.getAsyncResponse()
    END IF

    IF cws_get_finish_worksHTTPResp IS NULL THEN
      # We got no response, still waiting for
      CALL WSHelper_FillSOAP11WSError("Client","Response was not yet received")
      RETURN -2
    END IF

      #

  #
  IF GetOrderInfoHTTPReq IS NULL THEN
    # No request was sent
    CALL WSHelper_FillSOAP11WSError("Client","No request has been sent")
    RETURN -1
  END IF

  TRY
    #
    # PROCESS RESPONSE
    #
    IF GetOrderInfoHTTPResp IS NULL THEN
      # Still no response, try again
      LET GetOrderInfoHTTPResp = GetOrderInfoHTTPReq.getAsyncResponse()
    END IF

    IF GetOrderInfoHTTPResp IS NULL THEN
      # We got no response, still waiting for
      CALL WSHelper_FillSOAP11WSError("Client","Response was not yet received")
      RETURN -2
    END IF

      #

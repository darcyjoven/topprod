    RETURN -1
  END IF

  TRY
    #
    # PROCESS RESPONSE
    #
    IF GetDocumentNumberHTTPResp IS NULL THEN
      # Still no response, try again
      LET GetDocumentNumberHTTPResp = GetDocumentNumberHTTPReq.getAsyncResponse()
    END IF

    IF GetDocumentNumberHTTPResp IS NULL THEN
      # We got no response, still waiting for
      CALL WSHelper_FillSOAP11WSError("Client","Response was not yet received")
      RETURN -2
    END IF

      #

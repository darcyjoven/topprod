    RETURN -1
  END IF

  TRY
    #
    # PROCESS RESPONSE
    #
    IF DeductScoreHTTPResp IS NULL THEN
      # Still no response, try again
      LET DeductScoreHTTPResp = DeductScoreHTTPReq.getAsyncResponse()
    END IF

    IF DeductScoreHTTPResp IS NULL THEN

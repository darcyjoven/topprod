  TRY
    LET CreateWOStockinDataHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL CreateWOStockinDataHTTPReq.setMethod("POST")
    CALL CreateWOStockinDataHTTPReq.setCharset("UTF-8")

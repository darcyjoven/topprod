    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie IS NOT NULL THEN
      CALL GetWOStockQtyHTTPReq.setHeader("Cookie",TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie)
    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout <> 0 THEN
      CALL GetWOStockQtyHTTPReq.setConnectionTimeout(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout)

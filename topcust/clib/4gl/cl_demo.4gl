        WHEN 500 # SOAP Fault
          #
          # STAX SOAP FAULT
          #
          LET reader = GetWODataHTTPResp.beginXmlResponse() # Begin Streaming Response
          IF NOT WSHelper_ReadStaxSOAP11StartEnvelope(reader) THEN
            EXIT CASE
          END IF

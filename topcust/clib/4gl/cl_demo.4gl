          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetWarehouseDataHTTPResp.getStatusCode()||" ("||GetWarehouseDataHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY

  #
  # RESET VARIABLES
  #
  LET GetWarehouseDataHTTPReq = NULL
  LET GetWarehouseDataHTTPResp = NULL
  RETURN wsstatus
END FUNCTION




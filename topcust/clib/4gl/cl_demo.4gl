          CALL xml.Serializer.StaxToVariable(reader,GetImgb03Response)
          IF NOT WSHelper_ReadStaxSOAP11EndBody(reader) THEN
            EXIT CASE
          END IF
          IF NOT WSHelper_ReadStaxSOAP11EndEnvelope(reader) THEN
            EXIT CASE
          END IF
          # End Streaming Response
          CALL GetImgb03HTTPResp.endXmlResponse(reader)
          LET wsstatus = 0

        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetImgb03HTTPResp.getStatusCode()||" ("||GetImgb03HTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY

  #
  # RESET VARIABLES
  #
  LET GetImgb03HTTPReq = NULL
  LET GetImgb03HTTPResp = NULL
  RETURN wsstatus
END FUNCTION



#

          CALL GetFifo2HTTPResp.endXmlResponse(reader)
          LET wsstatus = 0

        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetFifo2HTTPResp.getStatusCode()||" ("||GetFifo2HTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY

  #
  # RESET VARIABLES
  #
  LET GetFifo2HTTPReq = NULL
  LET GetFifo2HTTPResp = NULL
  RETURN wsstatus
END FUNCTION



#

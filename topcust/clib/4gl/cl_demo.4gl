        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||UpdateReceiptHTTPResp.getStatusCode()||" ("||UpdateReceiptHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY


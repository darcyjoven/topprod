    # PROCESS RESPONSE
    #
    IF CreateAddressDataHTTPResp IS NULL THEN
      # Still no response, try again
      LET CreateAddressDataHTTPResp = CreateAddressDataHTTPReq.getAsyncResponse()
    END IF


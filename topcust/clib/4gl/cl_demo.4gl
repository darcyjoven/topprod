          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetApmt110HTTPResp.getStatusCode()||" ("||GetApmt110HTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY


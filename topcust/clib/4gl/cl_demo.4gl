  TRY
    LET CreateBOMMasterDataHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL CreateBOMMasterDataHTTPReq.setMethod("POST")
    CALL CreateBOMMasterDataHTTPReq.setCharset("UTF-8")

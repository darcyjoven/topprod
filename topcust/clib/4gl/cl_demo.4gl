#
FUNCTION CheckCard(p_request)
  DEFINE	soapStatus		INTEGER
  DEFINE	p_request		STRING

  LET CheckCardRequest.request = p_request

  LET soapStatus = CheckCard_g()

  RETURN soapStatus, CheckCardResponse.response
END FUNCTION

#

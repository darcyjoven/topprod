          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetCashCardInfoHTTPResp.getStatusCode()||" ("||GetCashCardInfoHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH

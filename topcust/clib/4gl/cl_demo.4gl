  TRY
    LET CheckCardTypeHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL CheckCardTypeHTTPReq.setMethod("POST")

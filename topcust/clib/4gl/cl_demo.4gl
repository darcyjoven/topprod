          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetCheckGoodsInHTTPResp.getStatusCode()||" ("||GetCheckGoodsInHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY

  #
  # RESET VARIABLES
  #
  LET GetCheckGoodsInHTTPReq = NULL
  LET GetCheckGoodsInHTTPResp = NULL
  RETURN wsstatus
END FUNCTION




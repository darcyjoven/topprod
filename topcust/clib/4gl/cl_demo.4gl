  #
  IF cws_create_finish_workHTTPReq IS NULL THEN
    # No request was sent
    CALL WSHelper_FillSOAP11WSError("Client","No request has been sent")
    RETURN -1
  END IF

  TRY
    #
    # PROCESS RESPONSE
    #
    IF cws_create_finish_workHTTPResp IS NULL THEN
      # Still no response, try again
      LET cws_create_finish_workHTTPResp = cws_create_finish_workHTTPReq.getAsyncResponse()
    END IF

    IF cws_create_finish_workHTTPResp IS NULL THEN
      # We got no response, still waiting for
      CALL WSHelper_FillSOAP11WSError("Client","Response was not yet received")
      RETURN -2
    END IF

      #
      # RETRIEVE SERVICE SESSION COOKIE

        OTHERWISE
          CALL WSHelper_FillSOAP11WSError("Server","HTTP Error "||GetItemNoHTTPResp.getStatusCode()||" ("||GetItemNoHTTPResp.getStatusDescription()||")")

      END CASE
    CATCH
      LET wsstatus = status
      CALL WSHelper_FillSOAP11WSError("Server",SQLCA.SQLERRM)
    END TRY


    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie IS NOT NULL THEN
      CALL CheckMemberUpgradeHTTPReq.setHeader("Cookie",TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.Cookie)
    END IF
    IF TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout <> 0 THEN
      CALL CheckMemberUpgradeHTTPReq.setConnectionTimeout(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Binding.ConnectionTimeout)
    END IF

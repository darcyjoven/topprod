  TRY
    LET GetTcimnFifoHTTPReq = com.HTTPRequest.Create(TIPTOPServiceGateWay_TIPTOPServiceGateWayPortTypeEndpoint.Address.Uri)
    CALL GetTcimnFifoHTTPReq.setMethod("POST")
    CALL GetTcimnFifoHTTPReq.setCharset("UTF-8")

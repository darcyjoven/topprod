----------------------------------------------------------------------------------
-- cpms010.per  采购参数作业(示例作业)画面档
-- 与 topcust/cpm/4gl/cpms010.4gl 配套;结构参照 tiptop/asm/per/asms112.per
-- and01~and20 为画面可见参数;andud01~andud15 为隐藏的自订预留字段
-- (本文件为手写来源档,直接以 fglform 编译即可,未经 Genero Studio 导出)
----------------------------------------------------------------------------------

SCHEMA ds

LAYOUT (spacing=normal, text=%"cpms010")
VBox VBox1
Folder pc194
Page page01(text="Main")
Grid gr907
{
 <G group01                                                            >
  参数1     [and01       ]
  参数2     [and02       ]
  参数3     [and03       ]
  参数4     [and04       ]
  参数5     [and05       ]
  参数6     [and06       ]
  参数7     [and07       ]
  参数8     [and08       ]
  参数9     [and09       ]
  参数10    [and10       ]
  参数11    [and11  ]
  参数12    [and12  ]
  参数13    [and13  ]
  参数14    [and14  ]
  参数15    [and15       ]
  参数16    [and16       ]
  参数17    [and17       ]
  参数18    [and18                                                  ]
  参数19    [and19                                                  ]
  参数20    [and20                                                  ]
  --自订预留字段:画面隐藏,随参数一起保存(INPUT BY NAME g_and.* 需要)
  [andud01 ][andud02 ][andud03 ][andud04 ][andud05 ]
  [andud06 ][andud07 ][andud08 ][andud09 ][andud10 ]
  [andud11 ][andud12 ][andud13 ][andud14 ][andud15 ]
 <                                                                     >
}
END -- gr907
END -- page01
END -- pc194
END -- VBox1
END -- cpms010


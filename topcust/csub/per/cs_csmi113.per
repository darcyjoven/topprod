SCHEMA formonly

LAYOUT (text=%"Form")
VBox VBox1
Grid Grid2
{

       基础资料  -------------------------------------------------------------------------------------------------
       料件编号[ima01               ]订单数量[oeb12             ] 备品   [bei               ]
       PNL排版 [pnls          ]      SET排版 [sets           ]    宽幅   [kuan           ]
       匹配排版资料  ---------------------------------------------------------------------------------------------
       市场类型[tc_sma02            ]宽幅      [tc_sma04        ]层数    [tc_sma07      ]料号     [tc_sma09      ]
       良率    [tc_sma10            ]出货资料数[tc_sma12        ]最低投料数[tc_sma13        ]
       首件损耗[tc_sma15            ]阻抗损耗  [im][tc_sma16    ]卷料损耗[ro][tc_sma18  ]辅料损耗 [tc_sma19      ]

       结果[btn       ] ------------------------------------------------------------------------------------------
      [pcs                                                                               ]   =    [pnl           ]
       +首件损耗  [first                   ]
       +阻抗损耗  [impedance               ]
       +卷料损耗  [roll                    ]
       主板PNL    [main                    ]   辅材PNL    [sub                     ]












}
END -- Grid2
END -- VBox1
END -- Form


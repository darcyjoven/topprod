    type report record
        date            varchar(20),
        time            varchar(20),
        remaining       varchar(5),
        curr_rate       decimal(20,10),
        previous_rate   decimal(20,10),
        last_month      varchar(20),
        product record
            normal  record
                day project,
                month project
            end record,
            rework_in  record
                day project,
                month project
            end record,
            rework_out  record
                day project,
                month project
            end record
        end record,
        sale record
            normal record
                day project,
                month project
            end record,
            return record
                day project,
                month project
            end record,
            discount project2,
            resell project2,
            unsign record
                fpc  decimal(20,3),
                smt decimal(20,3),
                comp decimal(20,3),
                sample decimal(20,3)
            end record
        end record,
        stock record
            normal      decimal(20,3),
            sample      decimal(20,3),
            inaction    decimal(20,3),
            return      decimal(20,3)
        end record,
        forecast record
            sale project2,
            product project2
        end record
